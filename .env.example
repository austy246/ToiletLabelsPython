# Příklad lokálních hodnot pro docker-compose.yml. Skutečné hodnoty patří do gitignorovaných souborů.

# .env.local (nepovinný, gitignorovaný): přihlášení admina v lokální aplikaci.
# Bez něj aplikace běží, jen se nevytvoří admin účet.
Admin__UserName=austy
Admin__Password=change-me-local-only

# .env (compose z něj čte jen toto): klíč k mapám Mapy.com.
# Bez klíče se mapa na hlavní stránce skryje.
# MAPY_API_KEY=your-mapy-api-key
